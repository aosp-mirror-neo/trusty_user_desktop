package {
    default_team: "trendy_team_desktop_security",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "libdesktop_hwsec_keymint_legacy_client_defaults",
    rustlibs: [
        "libkmr_ta",
        "libkmr_wire",
        "liblog_rust",
        "libthiserror",
        // TODO(mvertescher): Enable once we fix visibility
        // "libx509_cert",
    ],
    proc_macros: ["libpaste"],
}

rust_library {
    name: "libdesktop_hwsec_keymint_legacy_client",
    crate_name: "desktop_hwsec_keymint_legacy_client",
    srcs: ["lib.rs"],
    defaults: ["libdesktop_hwsec_keymint_legacy_client_defaults"],
    rustlibs: [
        "libtrusty-rs",
    ],
}

rust_test {
    name: "libdesktop_hwsec_keymint_legacy_client_test",
    crate_name: "libdesktop_hwsec_keymint_legacy_client_test",
    srcs: ["lib.rs"],
    defaults: ["libdesktop_hwsec_keymint_legacy_client_defaults"],
    test_suites: ["general-tests"],
    auto_gen_config: true,
    host_supported: true,
}
