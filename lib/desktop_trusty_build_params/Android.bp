package {
    default_team: "trendy_team_desktop_security",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

GSC_FW_TYPE = select(soong_config_variable("gsc", "fw_type"), {
    any @ value: value,
    default: "",
})

genrule {
    name: "desktop_trusty_build_params_rs",
    srcs: ["desktop_trusty_build_params_rules.mk"],
    out: [
        "lib.rs",
        "rules.mk",
    ],
    cmd: "(" +
        "    echo '#![no_std]';" +
        "    echo '#![allow(missing_docs)]';" +
        "    echo 'pub const GSC_FW_TYPE: &str = " + GSC_FW_TYPE + ";'" +
        ") > $(genDir)/lib.rs;" +
        "cp $(location desktop_trusty_build_params_rules.mk) $(genDir)/rules.mk;",
}
