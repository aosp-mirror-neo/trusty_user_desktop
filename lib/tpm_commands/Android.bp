rust_defaults {
    name: "libdesktop_hwsec_tpm_commands_defaults",
    rustlibs: [
        "libopen_enum",
        "libthiserror",
        "libzerocopy",
    ],
    proc_macros: ["libpaste"],
}

rust_library {
    name: "libdesktop_hwsec_tpm_commands",
    crate_name: "desktop_hwsec_tpm_commands",
    srcs: ["lib.rs"],
    defaults: ["libdesktop_hwsec_tpm_commands_defaults"],
}

rust_test {
    name: "libdesktop_hwsec_tpm_commands_test",
    crate_name: "libdesktop_hwsec_tpm_commands_test",
    srcs: ["lib.rs"],
    defaults: ["libdesktop_hwsec_tpm_commands_defaults"],
    test_suites: ["general-tests"],
    auto_gen_config: true,
    host_supported: true,
}
