package android.desktop.security.boot_params;

/**
 */
@SensitiveData
interface IBootParams {
    /** Invalid argument provided */
    const int ERROR_INVALID_ARGUMENT = 1;

    /** Error from OpenSSL */
    const int ERROR_OPENSSL = 2;

    /**
     * Requests the early entropy generated by the GSC for seeding the RNG.
     *
     * @return             The entropy generated by the GSC at init time.
     *
     */
    byte[] getEarlyEntropy();
    /**
     * Requests the CDI sealing key.
     *
     * @return             The CDI sealing key.
     *
     */
    byte[] getCdiSeal();
    /**
     * Requests the CDI attestation key.
     *
     * @return             The CDI attestation key.
     *
     */
    byte[] getCdiAttest();
    /**
     * Requests the auth token key seed.
     *
     * @return             The auth token key seed.
     *
     */
    byte[] getAuthTokenKeySeed();
    /**
     * Extracts a PRK from the session key seed using the provided salt.
     *
     * @param              A salt used to ensure channel uniqueness.
     * @return             The salted PRK from session key seed.
     * @throws             Service specific exception if HKDF extraction fails.
     */
    byte[] deriveSessionKey(in byte[] salt);
}
