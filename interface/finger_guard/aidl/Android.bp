aidl_interface {
    name: "android.desktop.security.finger_guard",
    owner: "google",
    unstable: true,
    vendor_available: true,
    srcs: [
        "android/desktop/security/finger_guard/AuthenticationResult.aidl",
        "android/desktop/security/finger_guard/EnrollmentResult.aidl",
        "android/desktop/security/finger_guard/FinishEnrollSessionResponse.aidl",
        "android/desktop/security/finger_guard/HandshakeResponse.aidl",
        "android/desktop/security/finger_guard/HardwareAuthToken.aidl",
        "android/desktop/security/finger_guard/IFingerGuard.aidl",
        "android/desktop/security/finger_guard/LockoutStatus.aidl",
        "android/desktop/security/finger_guard/PrepareAuthSessionResponse.aidl",
        "android/desktop/security/finger_guard/PrepareEnrollSessionResponse.aidl",
        "android/desktop/security/finger_guard/SensorUserPair.aidl",
        "android/desktop/security/finger_guard/SessionResponse.aidl",
    ],
    frozen: false,
    backend: {
        rust: {
            enabled: true,
            apex_available: [
                "//apex_available:platform",
                "com.android.virt",
            ],
        },
        java: {
            enabled: false,
        },
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: false,
        },
    },
}
